{
  // https://nuxt.com/docs/guide/concepts/typescript
  "extends": "./.nuxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "types": ["vitest/globals"]
  },
  "include": [
    "./.nuxt/nuxt.d.ts",
    "./.nuxt/types/nitro-imports.d.ts",
    "./.nuxt/types/nitro-routes.d.ts",
    "features/**/*",
    "pages/**/*",
    "components/**/*",
    "types/**/*",
    "lib/**/*",
    "server/**/*",
    "tests/**/*"
  ]
}
