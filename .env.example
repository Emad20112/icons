# ==============================================================================
# DIGITAL ASSETS PLATFORM - ENVIRONMENT CONFIGURATION (PHASE 0)
# ==============================================================================

# Public Client Configuration (Safe for browser bundle)
NUXT_PUBLIC_APP_NAME="Digital Assets Platform"
NUXT_PUBLIC_APP_ENV="development"
NUXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NUXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Storage Bucket Names
NUXT_PUBLIC_STORAGE_ASSETS_BUCKET="assets"
NUXT_PUBLIC_STORAGE_TEMP_BUCKET="temp-uploads"

# ==============================================================================
# SENSITIVE SERVER-ONLY SECRETS (CRITICAL: NEVER EXPOSE TO CLIENT / BROWSER)
# ==============================================================================
# The Service Role Key bypasses Row Level Security (RLS).
# MUST only be used in trusted server-side Nitro endpoints for administrative
# tasks, audit logging, and elevated sync procedures.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# Server Security & Audit
SECURITY_MAX_FILE_SIZE_BYTES=52428800 # 50 MB
SECURITY_RATE_LIMIT_MAX_REQUESTS=100
SECURITY_RATE_LIMIT_WINDOW_MS=60000
