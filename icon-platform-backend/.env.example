# Iconify Backend Service Configuration
PORT=4000
HOST=0.0.0.0
NODE_ENV=production
FRONTEND_ORIGIN=http://localhost:3000

# Upstream Iconify Public API Configuration
ICONIFY_API_BASE_URL=https://api.iconify.design
ICONIFY_API_FALLBACK_URL=https://api.simplesvg.com
UPSTREAM_TIMEOUT_MS=8000
MAX_UPSTREAM_CONCURRENCY=50

# Rate Limiting Configuration (Per IP)
SEARCH_RATE_LIMIT=20
COLLECTIONS_RATE_LIMIT=30
ICON_RATE_LIMIT=60
SVG_RATE_LIMIT=45
GLOBAL_UPSTREAM_RATE_LIMIT=200

# Controlled In-Memory Caching Configuration
CACHE_ENABLED=true
CACHE_MAX_ENTRIES=5000
SEARCH_CACHE_TTL_MS=120000
COLLECTIONS_CACHE_TTL_MS=3600000
ICON_CACHE_TTL_MS=600000
SVG_CACHE_TTL_MS=600000

# Circuit Breaker Configuration
CIRCUIT_BREAKER_FAIL_THRESHOLD=5
CIRCUIT_BREAKER_RESET_TIMEOUT_MS=30000

# Optional Supabase Integration (Leave empty for anonymous / public access)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
